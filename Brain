function pickQ(){
const e=shuffle(QUESTIONS.filter(q=>q.d===“easy”)).slice(0,3);
const m=shuffle(QUESTIONS.filter(q=>q.d===“medium”)).slice(0,4);
const h=shuffle(QUESTIONS.filter(q=>q.d===“hard”)).slice(0,3);
return […e,…m,…h].map(q=>({q:q.q,options:q.o,answer:q.a,difficulty:q.d,cat:q.cat}));
}

