/* ══ EVENTS ═══════════════════════════════════════════════════════ */
function bind(){
el(“bcreate”)?.addEventListener(“click”,async()=>{
const name=el(“hname”)?.value?.trim();
if(!name){el(“hname”).style.borderColor=“var(–wrong)”;return;}
const code=randCode();
S.roomCode=code;S.isHost=true;S.playerId=“p0”;S.playerIdx=0;S.playerName=name;
const qs=pickQ();
await set(rRef(),{host:“p0”,status:“waiting”,qIndex:-1,soloIdx:-1,answers:{},questions:qs,players:{p0:{name,score:0,lastGained:0,idx:0}}});
goWait();
});
el(“bjoin”)?.addEventListener(“click”,()=>{S.screen=“join”;render();});
el(“bjdo”)?.addEventListener(“click”,async()=>{
const name=el(“jname”)?.value?.trim(),code=el(“jcode”)?.value?.trim().toUpperCase();
if(!name||!code){el(“jerr”).textContent=“Remplis tous les champs.”;return;}
try{
const snap=await get(ref(db,`rooms/${code}`));
if(!snap.exists()) throw new Error(“Salon introuvable”);
const room=snap.val();
if(room.status!==“waiting”) throw new Error(“Partie déjà commencée”);
const nb=Object.keys(room.players||{}).length;
if(nb>=6) throw new Error(“Salon plein”);
const pid=“p”+nb;
S.roomCode=code;S.playerId=pid;S.playerIdx=nb;S.playerName=name;S.isHost=false;
await update(ref(db,`rooms/${code}/players/${pid}`),{name,score:0,lastGained:0,idx:nb});
goWait();
}catch(e){el(“jerr”).textContent=e.message;}
});
el(“bback”)?.addEventListener(“click”,()=>{S.screen=“lobby”;render();});
el(“bstart”)?.addEventListener(“click”,async()=>{
if(S.players.length<2) return;
const si=Math.floor(Math.random()*S.players.length);
await update(rRef(),{status:“alliance_check”,qIndex:0,soloIdx:si,answers:{}});
});
el(“bgo”)?.addEventListener(“click”,()=>{S.screen=“question”;render();startT();});
document.querySelectorAll(”.opt-btn”).forEach(btn=>{
btn.addEventListener(“click”,async()=>{
if(S.myAnswer!==null) return;
const i=parseInt(btn.dataset.i);
S.myAnswer=i;
const opt=S.shuffledOpts[i];
const ok=opt.origIdx===S.questions[S.qIndex].answer;
const base=ok?Math.round(800+200*(S.timerVal/TIMER)):0;
const isAl=ALROUNDS.includes(S.qIndex);
const pts=isAl&&base>0?(S.playerIdx===S.soloIdx?Math.round(base*3):Math.round(base*1.5)):base;
stopT();
btn.style.background=ok?”#06d6a018”:”#ff4d6d18”;
btn.style.borderColor=ok?“var(–correct)”:“var(–wrong)”;
// Montrer la bonne réponse
document.querySelectorAll(”.opt-btn”).forEach((b,bi)=>{
if(S.shuffledOpts[bi]?.origIdx===S.questions[S.qIndex].answer) b.style.borderColor=“var(–correct)”;
});
await update(rRef(`answers/${S.playerId}`),{shuffIdx:i,points:pts,correct:ok});
const optsDiv=el(“opts”);
if(optsDiv) optsDiv.insertAdjacentHTML(“afterend”,`<div style="text-align:center;padding:13px;border-radius:13px;background:var(--correct)10;border:1px solid var(--correct)30;color:var(--correct);font-family:'Syne',sans-serif;font-weight:800;font-size:13px;animation:pop .3s both;">✓ Réponse enregistrée !</div>`);
});
});
el(“bnext”)?.addEventListener(“click”,async()=>{
const next=S.qIndex+1;
if(next>=TOTAL){await update(rRef(),{status:“podium”});}
else{const al=ALROUNDS.includes(next),ns=al?Math.floor(Math.random()*S.players.length):-1;await update(rRef(),{status:al?“alliance_check”:“question”,qIndex:next,soloIdx:ns,answers:{}});}
});
el(“brestart”)?.addEventListener(“click”,()=>{
detach();
S={screen:“lobby”,roomCode:null,playerId:null,playerName:null,playerIdx:null,isHost:false,players:[],questions:[],qIndex:0,soloIdx:null,myAnswer:null,shuffledOpts:[],lay:“grid2x2”,timerVal:TIMER,timerInterval:null,unsubs:[],answers:{}};
render();
});
}

/* ══ TIMER ════════════════════════════════════════════════════════ */
function stopT(){if(S.timerInterval){clearInterval(S.timerInterval);S.timerInterval=null;}}
function startT(){
stopT();S.timerVal=TIMER;
S.timerInterval=setInterval(async()=>{
S.timerVal–;
const r=32,ci=2*Math.PI*r,pct=S.timerVal/TIMER,tc=pct>.5?”#06d6a0”:pct>.25?”#ffd166”:”#ff4d6d”;
const ring=el(“tr”),num=el(“tn”);
if(ring){ring.style.stroke=tc;ring.setAttribute(“stroke-dashoffset”,ci*(1-pct));}
if(num){num.textContent=S.timerVal;num.style.color=tc;}
if(S.timerVal<=0){stopT();if(S.myAnswer===null){S.myAnswer=-1;await update(rRef(`answers/${S.playerId}`),{shuffIdx:-1,points:0,correct:false});}}
},1000);
}

/* ══ FIREBASE LISTENER ════════════════════════════════════════════ */
function detach(){S.unsubs.forEach(u=>u());S.unsubs=[];stopT();}
function goWait(){
S.screen=“waiting”;render();
const unsub=onValue(rRef(),snap=>{
if(!snap.exists()) return;
const room=snap.val();
const players=Object.values(room.players||{}).sort((a,b)=>a.idx-b.idx);
S.players=players;S.questions=room.questions||[];
S.qIndex=room.qIndex>=0?room.qIndex:0;
S.soloIdx=room.soloIdx>=0?room.soloIdx:null;
S.answers=room.answers||{};
const st=room.status;
if(st===“question”){
const allAns=Object.keys(S.answers).length>=players.length;
if(allAns&&S.isHost){
stopT();
const upd={};
players.forEach((pl,i)=>{const ans=S.answers[“p”+i];const g=ans?.points||0;upd[`rooms/${S.roomCode}/players/p${i}/score`]=(pl.score||0)+g;upd[`rooms/${S.roomCode}/players/p${i}/lastGained`]=g;});
update(ref(db),upd).then(()=>update(rRef(),{status:“scoreboard”}));
return;
}
}
if(st===“waiting”&&S.screen===“waiting”) render();
else if(st===“alliance_check”&&S.screen!==“alliance”){stopT();S.myAnswer=null;prepQ();S.screen=“alliance”;render();}
else if(st===“question”&&S.screen!==“question”){stopT();S.myAnswer=null;prepQ();S.screen=“question”;render();startT();}
else if(st===“scoreboard”&&S.screen!==“scoreboard”){stopT();S.players=players;S.screen=“scoreboard”;render();}
else if(st===“podium”&&S.screen!==“podium”){stopT();S.players=players;S.screen=“podium”;render();}
});
S.unsubs.push(unsub);
}
function prepQ(){
const q=S.questions[S.qIndex];if(!q) return;
S.shuffledOpts=shuffle(q.options.map((text,origIdx)=>({text,origIdx})));
S.lay=layout(S.qIndex*7+Math.floor(Math.random()*7));
