};

const firebaseApp = initializeApp(firebaseConfig);
const db = getDatabase(firebaseApp);

/* ══════════════════════════════════════
   CONSTANTES
══════════════════════════════════════ */
const PALETTES = [
  {main:"#ff4d6d",bg:"#ff4d6d18",border:"#ff4d6d40"},
  {main:"#00b4d8",bg:"#00b4d818",border:"#00b4d840"},
  {main:"#a855f7",bg:"#a855f718",border:"#a855f740"},
  {main:"#06d6a0",bg:"#06d6a018",border:"#06d6a040"},
  {main:"#ffd166",bg:"#ffd16618",border:"#ffd16640"},
  {main:"#ff8500",bg:"#ff850018",border:"#ff850040"},
];
const EMOJIS = ["🔥","⚡","💜","🌊","👑","🎯"];
const TIMER_SEC = 20;
const TOTAL_Q = 10;
const ALLIANCE_ROUNDS = [3,6,9];
const THEMES = ["Cinéma","Musique","Sport","Géographie","Gastronomie","Science","Jeux vidéo","Animaux","Séries TV","Histoire","Culture générale","Espace"];
const LAYOUTS = ["grid2x2","list","asymL","wide","grid2x2"];

/* ══════════════════════════════════════
   STATE GLOBAL
══════════════════════════════════════ */
let STATE = {
  screen: "lobby",      // lobby|join|waiting|alliance|question|scoreboard|podium
  roomCode: null,
  playerId: null,
  playerName: null,
  playerIdx: null,
  isHost: false,
  players: [],          // [{id,name,score,lastGained,ready}]
  questions: [],
  qIndex: 0,
  soloIdx: null,
  myAnswer: null,       // index shuffled choisi
  answers: {},          // {playerId: {shuffIdx, points, time}}
  shuffledOpts: [],     // [{text,origIdx}]
  layout: "grid2x2",
  timerVal: TIMER_SEC,
  timerInterval: null,
  unsubs: [],           // firebase listeners à détacher
};

/* ══════════════════════════════════════
   UTILS
══════════════════════════════════════ */
function shuffle(arr){
  const a=[...arr];
  for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}
  return a;
}
function randCode(){return Math.random().toString(36).substr(2,4).toUpperCase();}
function el(id){return document.getElementById(id);}
function pickLayout(seed){return LAYOUTS[seed%LAYOUTS.length];}
function pal(idx){return PALETTES[idx%PALETTES.length];}

/* ══════════════════════════════════════
   CLAUDE API — génération questions
══════════════════════════════════════ */
async function generateQuestions(theme){
  const res = await fetch("https://api.anthropic.com/v1/messages",{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({
      model:"claude-sonnet-4-20250514",
      max_tokens:1200,
      messages:[{role:"user",content:`Génère exactement 10 questions de quiz sur : "${theme}".
Les 3 premières FACILES, les 4 suivantes MOYENNES, les 3 dernières DIFFICILES.
Réponds UNIQUEMENT avec du JSON valide, sans markdown ni backticks.
Format : [{"q":"question?","options":["A","B","C","D"],"answer":0,"difficulty":"easy"}]
- answer = index 0-3 de la bonne réponse dans options
- difficulty = "easy"|"medium"|"hard"
- En français, fun, varié`}]
    })
  });
  const data = await res.json();
  const raw = data.content[0].text.trim().replace(/```json|```/g,"").trim();
  return JSON.parse(raw);
}

/* ══════════════════════════════════════
   FIREBASE HELPERS
══════════════════════════════════════ */
function roomRef(path=""){return ref(db,`rooms/${STATE.roomCode}${path?"/"+path:""}`)}

async function createRoom(name,theme){
  const code = randCode();
  STATE.roomCode = code;
  STATE.isHost = true;
  STATE.playerId = "p0";
  STATE.playerIdx = 0;
  STATE.playerName = name;
  await set(roomRef(),{
    host:"p0",theme,
    status:"waiting",
    qIndex:-1,soloIdx:-1,
    players:{p0:{name,score:0,lastGained:0,idx:0,ready:true}},
    questions:[],answers:{}
  });
  return code;
}

async function joinRoom(code,name){
  const snap = await get(ref(db,`rooms/${code}`));
  if(!snap.exists()) throw new Error("Salon introuvable");
  const room = snap.val();
  if(room.status !== "waiting") throw new Error("Partie déjà commencée");
  const existing = Object.keys(room.players||{});
  if(existing.length >= 6) throw new Error("Salon plein (6 max)");
  const pid = "p"+existing.length;
  const idx = existing.length;
  STATE.roomCode = code;
  STATE.playerId = pid;
  STATE.playerIdx = idx;
  STATE.playerName = name;
  STATE.isHost = false;
  await update(ref(db,`rooms/${code}/players/${pid}`),{name,score:0,lastGained:0,idx,ready:true});
  return room;
}

/* ══════════════════════════════════════
   RENDER ENGINE
══════════════════════════════════════ */
function render(){
  const app = document.getElementById("app");
  app.innerHTML = "";
  const screens = {
    lobby: renderLobby,
    join: renderJoin,
    waiting: renderWaiting,
    loading: renderLoading,
    alliance: renderAlliance,
    question: renderQuestion,
    scoreboard: renderScoreboard,
    podium: renderPodium,
  };
  const fn = screens[STATE.screen];
  if(fn) app.innerHTML = fn();
  attachEvents();
}

/* ══════════════════════════════════════
   SCREEN: LOBBY
══════════════════════════════════════ */
function renderLobby(){
  const themeChips = THEMES.slice(0,8).map(t=>`
    <button class="theme-chip" data-theme="${t}" style="background:var(--card);border:1px solid var(--border);border-radius:99px;padding:6px 13px;color:var(--muted);font-size:12px;font-weight:600;font-family:'DM Sans',sans-serif;transition:all .15s;">${t}</button>
  `).join("");

  return `
  <svg class="noise"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency=".65" numOctaves="3" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter><rect width="100%" height="100%" filter="url(#n)"/></svg>
  <div class="screen" style="justify-content:flex-start;gap:0;">
    <div class="center" style="margin-bottom:36px;animation:fadeUp .6s both;">
      <div style="font-size:11px;letter-spacing:5px;color:var(--muted);text-transform:uppercase;margin-bottom:10px;">Quiz · Battle · Alliance</div>
      <h1 style="font-family:'Syne',sans-serif;font-size:clamp(50px,14vw,68px);font-weight:800;line-height:.9;color:var(--text);text-shadow:0 0 60px #ff4d6d40;">BRAIN<br><span style="background:linear-gradient(90deg,var(--accent),var(--accentB));-webkit-background-clip:text;-webkit-text-fill-color:transparent;">BRAWL</span></h1>
      <div style="margin-top:12px;color:var(--muted);font-size:13px;">2–6 joueurs · Questions IA · Alliances & trahisons</div>
    </div>

    <div style="width:100%;max-width:460px;display:flex;flex-direction:column;gap:14px;">

      <div class="card" style="animation:fadeUp .6s .08s both;">
        <div class="label">Ton pseudo</div>
        <input id="host-name" maxlength="12" placeholder="Entre ton pseudo..." style="width:100%;background:var(--card);border:1.5px solid var(--border);border-radius:12px;padding:12px 14px;font-size:15px;font-weight:700;outline:none;transition:border .2s;"/>
      </div>

      <div class="card" style="animation:fadeUp .6s .14s both;">
        <div class="label">Thème</div>
        <input id="theme-input" maxlength="40" placeholder="Ex: Cinéma, Sport, Musique..." style="width:100%;background:var(--card);border:1.5px solid var(--border);border-radius:12px;padding:12px 14px;font-size:15px;outline:none;color:var(--text);transition:border .2s;margin-bottom:12px;"/>
        <div style="display:flex;flex-wrap:wrap;gap:8px;" id="theme-chips">${themeChips}</div>
      </div>

      <div class="card" style="background:#ff850008;border-color:#ff850025;animation:fadeUp .6s .2s both;">
        <div style="display:flex;gap:12px;align-items:flex-start;">
          <span style="font-size:20px;flex-shrink:0;">⚡</span>
          <div style="font-size:13px;color:var(--muted);line-height:1.6;">
            <span style="color:var(--text);font-weight:700;">Alliances & Trahisons</span> aux questions 4, 7 et 10.<br>
            Un joueur devient <span style="color:var(--solo);">Solo ×3</span>, les autres forment une <span style="color:var(--ally);">Alliance ×1.5</span>.
          </div>
        </div>
      </div>

      <div style="display:flex;gap:10px;animation:fadeUp .6s .26s both;">
        <button id="btn-create" class="btn btn-primary w100" style="font-size:16px;padding:17px;">⚡ Créer un salon</button>
        <button id="btn-join-screen" class="btn btn-ghost" style="padding:17px 20px;white-space:nowrap;">Rejoindre</button>
      </div>
    </div>
  </div>`;
}

/* ══════════════════════════════════════
   SCREEN: JOIN
══════════════════════════════════════ */
function renderJoin(){
  return `
  <svg class="noise"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency=".65" numOctaves="3" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter><rect width="100%" height="100%" filter="url(#n)"/></svg>
  <div class="screen" style="justify-content:center;">
    <div style="width:100%;max-width:400px;display:flex;flex-direction:column;gap:16px;animation:fadeUp .5s both;">
