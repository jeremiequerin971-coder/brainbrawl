/* ══════════════════════════════════════
   SCREEN: WAITING ROOM
══════════════════════════════════════ */
function renderWaiting(){
  const playersHTML = STATE.players.map((p,i)=>`
    <div style="display:flex;align-items:center;gap:12px;padding:13px 16px;background:${pal(i).bg};border:1.5px solid ${pal(i).border};border-radius:14px;animation:slideRight .35s ${i*.08}s both;">
      <span style="font-size:22px;">${EMOJIS[i%EMOJIS.length]}</span>
      <span style="font-weight:700;font-size:15px;flex:1;">${p.name}</span>
      ${i===0?`<span class="tag" style="background:#ffd16618;border:1px solid #ffd16640;color:var(--gold);">HOST</span>`:`<span style="color:var(--correct);font-size:18px;">✓</span>`}
    </div>
  `).join("");

  return `
  <svg class="noise"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency=".65" numOctaves="3" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter><rect width="100%" height="100%" filter="url(#n)"/></svg>
  <div class="screen" style="justify-content:center;">
    <div style="width:100%;max-width:420px;display:flex;flex-direction:column;gap:16px;">

      <div class="center" style="animation:fadeUp .4s both;">
        <div style="font-size:13px;color:var(--muted);margin-bottom:6px;">Code du salon</div>
        <div style="font-family:'Syne',sans-serif;font-size:52px;font-weight:800;color:var(--neon);letter-spacing:8px;text-shadow:0 0 30px #00f5d460;">${STATE.roomCode}</div>
        <div style="font-size:12px;color:var(--muted);margin-top:6px;">Partage ce code à tes potes</div>
      </div>

      <div class="card" style="animation:fadeUp .4s .1s both;">
        <div class="label">Joueurs (${STATE.players.length}/6)</div>
        <div style="display:flex;flex-direction:column;gap:10px;">${playersHTML}</div>
      </div>

      <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:12px 16px;font-size:13px;color:var(--muted);text-align:center;animation:fadeUp .4s .2s both;">
        Thème : <span style="color:var(--accent);font-weight:700;">${STATE.theme||"Aléatoire"}</span>
      </div>

      ${STATE.isHost ? `
        <button id="btn-start-game" class="btn btn-primary w100" style="font-size:16px;padding:17px;" ${STATE.players.length<2?"disabled":""}>
          ${STATE.players.length<2?"En attente de joueurs...":"⚡ Lancer la partie"}
        </button>
      ` : `
        <div style="text-align:center;color:var(--muted);font-size:14px;padding:16px;animation:pulse 2s infinite;">
          En attente du host...
        </div>
      `}
    </div>
  </div>`;
}

/* ══════════════════════════════════════
   SCREEN: LOADING
══════════════════════════════════════ */
function renderLoading(){
  return `
  <svg class="noise"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency=".65" numOctaves="3" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter><rect width="100%" height="100%" filter="url(#n)"/></svg>
  <div class="screen" style="justify-content:center;gap:28px;">
    <div style="font-size:60px;animation:float 2s ease-in-out infinite;">🧠</div>
    <div class="center">
