<!DOCTYPE html>

<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
<title>BrainBrawl</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;600;700&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --bg:#060608;--surface:#0e0e16;--card:#16161f;--border:#1e1e2e;
  --accent:#ff4d6d;--accentB:#ff8500;--neon:#00f5d4;--gold:#ffd166;
  --silver:#b8c0cc;--bronze:#c77d3a;--text:#eeeeff;--muted:#555570;
  --correct:#06d6a0;--wrong:#ff4d6d;--solo:#ff8500;--ally:#00b4d8;
}
html,body{height:100%;background:var(--bg);font-family:'DM Sans',sans-serif;color:var(--text);overflow-x:hidden;}
#app{min-height:100vh;}
button{cursor:pointer;font-family:'Syne',sans-serif;}
input{font-family:'DM Sans',sans-serif;color:var(--text);}
input::placeholder{color:#3a3a5a;}

@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@keyframes pop{0%{transform:scale(0.8);opacity:0}60%{transform:scale(1.08)}100%{transform:scale(1);opacity:1}}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-6px)}40%{transform:translateX(6px)}60%{transform:translateX(-4px)}80%{transform:translateX(4px)}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
@keyframes slideRight{from{opacity:0;transform:translateX(-20px)}to{opacity:1;transform:translateX(0)}}
@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@keyframes pulse{0%,100%{opacity:.4;transform:scale(1)}50%{opacity:.9;transform:scale(1.04)}}
@keyframes confettiFall{0%{transform:translateY(-20px) rotate(0deg);opacity:1}100%{transform:translateY(110vh) rotate(720deg);opacity:0}}

.screen{min-height:100vh;display:flex;flex-direction:column;align-items:center;padding:28px 18px 40px;}
.card{background:var(–surface);border:1px solid var(–border);border-radius:20px;padding:22px;}
.tag{display:inline-flex;align-items:center;gap:5px;border-radius:99px;padding:3px 11px;font-size:11px;font-weight:700;letter-spacing:1px;font-family:‘Syne’,sans-serif;text-transform:uppercase;}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:none;border-radius:14px;padding:15px 24px;font-size:15px;font-weight:800;letter-spacing:1px;transition:transform .1s,box-shadow .2s,opacity .2s;font-family:‘Syne’,sans-serif;}
.btn:active{transform:scale(.97)!important;}
.btn-primary{background:linear-gradient(135deg,var(–accent),var(–accentB));color:#fff;box-shadow:0 0 24px #ff4d6d50,0 4px 16px #00000060;}
.btn-ghost{background:transparent;border:1.5px solid var(–border);color:var(–muted);}
.btn-neon{background:#00f5d418;border:1.5px solid #00f5d460;color:var(–neon);box-shadow:0 0 16px #00f5d430;}
.btn:disabled{opacity:.4;cursor:not-allowed;}
.w100{width:100%;}
.center{text-align:center;}
.label{font-size:11px;letter-spacing:4px;color:var(–muted);text-transform:uppercase;margin-bottom:14px;font-family:‘Syne’,sans-serif;}

/* Timer ring */
.timer-wrap{position:relative;width:80px;height:80px;}
.timer-num{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:‘Syne’,sans-serif;font-size:24px;font-weight:800;}

/* Chips joueurs */
.chip{display:inline-flex;align-items:center;gap:6px;border-radius:99px;padding:4px 11px;font-size:13px;font-weight:700;}

/* Réponses */
.opt-btn{display:flex;align-items:center;gap:12px;padding:15px 14px;border-radius:16px;border:2px solid var(–border);background:var(–card);text-align:left;transition:border-color .18s,background .18s;width:100%;}
.opt-btn:hover{border-color:#ffffff30;}
.opt-letter{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-family:‘Syne’,sans-serif;font-size:13px;font-weight:800;flex-shrink:0;}
.opt-text{font-size:14px;font-weight:600;color:var(–text);line-height:1.3;font-family:‘DM Sans’,sans-serif;}

/* Progress */
.progress-bar{height:3px;background:var(–border);width:100%;}
.progress-fill{height:100%;background:linear-gradient(90deg,var(–accent),var(–accentB));transition:width .6s ease;}

/* Noise overlay */
.noise{position:fixed;inset:0;pointer-events:none;z-index:9999;opacity:.03;}
</style>

</head>
<body>
<div id="app"></div>

<!-- Firebase -->

<script type="module">
