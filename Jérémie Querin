        <div class="label">Code du salon</div>
        <input id="join-code" maxlength="4" placeholder="XXXX" style="width:100%;background:var(--card);border:1.5px solid var(--border);border-radius:12px;padding:12px 14px;font-size:26px;font-weight:800;outline:none;color:var(--neon);text-align:center;letter-spacing:6px;text-transform:uppercase;font-family:'Syne',sans-serif;"/>
